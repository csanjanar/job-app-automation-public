# Google OAuth (path to credentials file downloaded from Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_SHEET_ID=your-google-sheet-id-here

# Claude API (anthropic.com/console)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Firecrawl API (firecrawl.dev)
FIRECRAWL_API_KEY=fc-your-key-here

# GitHub docs repo — optional, only needed if you want generated application
# docs pushed to a separate repo (requires `gh auth login` once on this machine)
GITHUB_DOCS_REPO=your-github-username/your-docs-repo
